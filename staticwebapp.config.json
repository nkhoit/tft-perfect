{
  "globalHeaders": {
    "Cache-Control": "public, max-age=300"
  },
  "routes": [
    { "route": "/traits", "redirect": "/traits/", "statusCode": 301 },
    { "route": "/traits/vendor/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/traits/*", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/rolls", "redirect": "/rolls/", "statusCode": 301 },
    { "route": "/rolls/*", "headers": { "Cache-Control": "no-cache" } }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/shared/*",
      "/traits/*",
      "/rolls/*",
      "/*.css",
      "/*.js",
      "/*.json",
      "/*.wasm",
      "/*.png",
      "/*.svg",
      "/*.ico"
    ]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "mimeTypes": {
    ".json": "application/json",
    ".wasm": "application/wasm",
    ".js": "text/javascript"
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
